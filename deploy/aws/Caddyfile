# Stage A: TLS via Let's Encrypt for the same hostnames used on Render, and for institutions'
# own addresses (Phase 3E). Stage B replaces Caddy with an ALB + ACM (DEPLOYMENT.md §2.3).
{
	email {$ACME_EMAIL}
	# Institutions' subdomains and vanity domains get certificates on their first visit, but
	# only once the api confirms the host is an institution's (DOMAIN_PROVISIONER=caddy).
	on_demand_tls {
		ask http://api:4000/v1/hosts/tls-check
	}
}

{$APP_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web:3000
}

{$API_HOST} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	request_body {
		max_size 50MB
	}
	reverse_proxy api:4000
}

# Any other host: an institution's address (the web app serves its pages there).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:3000
}
