# ─── Production: AWS EC2 ap-southeast-1 + Supabase PRO (Singapore) ─────────────
# Stored in SSM Parameter Store under /hbe/prod/* and rendered to /opt/hbe/.env at boot.
# Lines marked CHANGED differ from the demo file. Everything else is copied as is.
HBE_ENV=production
# CHANGED (free → paid)
HBE_PLAN_PROFILE=paid
# ROLES is set per container in deploy/aws/docker-compose.prod.yml
TZ=Asia/Singapore
LOG_LEVEL=info

# same hostnames: no GitHub/LTI/OAuth changes
APP_URL=https://app.example.com
API_URL=https://api.example.com

# Upgrading the same Supabase project to Pro: these stay the same.
# Using a fresh Pro project instead: replace all five with the new project's values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
SUPABASE_SECRET_KEY=<sb_secret_...>
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
QUEUE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# prod App (or the demo App, if reused)
GITHUB_APP_ID=<id>
GITHUB_APP_CLIENT_ID=<client id>
GITHUB_APP_CLIENT_SECRET=<client secret>
GITHUB_APP_PRIVATE_KEY_BASE64=<base64 .pem>
GITHUB_WEBHOOK_SECRET=<secret>
GRADER_REPO=hbe-platform/hbe-grader

# Archive replica: AWS S3 in Singapore with Object Lock
# CHANGED (empty = AWS S3)
ARCHIVE_S3_ENDPOINT=
# CHANGED
ARCHIVE_S3_REGION=ap-southeast-1
# CHANGED
ARCHIVE_S3_BUCKET=hbe-prod-archive-sg
# Leave the keys empty on EC2: the SDK uses the instance role.  # CHANGED
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
# CHANGED
ARCHIVE_OBJECT_LOCK=governance

# or ses (then set AWS_SES_REGION)
EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM=HBE Platform <no-reply@example.com>
AWS_SES_REGION=ap-southeast-1

LTI_PRIVATE_KEY_BASE64=<same key as the demo, so LMS registrations keep working>
LTI_KEY_ID=lti-2026-01
GOOGLE_OAUTH_CLIENT_ID=<id>
GOOGLE_OAUTH_CLIENT_SECRET=<secret>
TOKEN_ENCRYPTION_KEY=<same key as the demo, or stored LMS tokens can't be decrypted>

SENTRY_DSN=<dsn>
OTEL_EXPORTER_OTLP_ENDPOINT=

# Image deployed by docker-compose.prod.yml
HBE_IMAGE=<account>.dkr.ecr.ap-southeast-1.amazonaws.com/hbe-app:<tag>
APP_HOST=app.example.com
API_HOST=api.example.com
ACME_EMAIL=ops@example.com
