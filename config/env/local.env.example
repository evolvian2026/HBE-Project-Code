# ─── Local development ─────────────────────────────────────────────────────────
# Copy to .env.local at the repo root. Values come from `supabase start` output.
HBE_ENV=local
HBE_PLAN_PROFILE=free
ROLES=web,api,worker
TZ=Asia/Singapore
LOG_LEVEL=debug

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<from supabase start>
SUPABASE_SECRET_KEY=<from supabase start>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
QUEUE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

GITHUB_APP_ID=<dev app id>
GITHUB_APP_CLIENT_ID=<dev app client id>
GITHUB_APP_CLIENT_SECRET=<dev app client secret>
GITHUB_APP_PRIVATE_KEY_BASE64=<base64 of the dev app .pem>
GITHUB_WEBHOOK_SECRET=<random 32+ chars>
GRADER_REPO=hbe-dev-org/hbe-grader

ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_BUCKET=
ARCHIVE_OBJECT_LOCK=none

EMAIL_PROVIDER=log
EMAIL_FROM=HBE Dev <dev@localhost>

TOKEN_ENCRYPTION_KEY=<32-byte base64: openssl rand -base64 32>
