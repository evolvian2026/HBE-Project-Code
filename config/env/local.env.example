# ─── Local development ─────────────────────────────────────────────────────────
# Generate .env.local from this file with `pnpm env:local` (after `pnpm db:start`); it fills in
# the local Supabase keys. Used by `pnpm dev`: web on :3000 (next dev), api + worker on :4000.
HBE_ENV=local
HBE_PLAN_PROFILE=free
ROLES=api,worker
PORT=4000
TZ=Asia/Singapore
LOG_LEVEL=info

APP_URL=http://localhost:3000
API_URL=http://localhost:4000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=<filled in by pnpm env:local>
SUPABASE_SECRET_KEY=<filled in by pnpm env:local>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
QUEUE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Without a GitHub App, GITHUB_FAKE=true uses an in-memory GitHub so repository creation
# can be tried locally. Set it to false once the dev App exists (docs/GITHUB_APP_SETUP.md).
GITHUB_FAKE=true
# A dev GitHub App is only needed to test GitHub sign-in and webhooks (smee.io forwards them).
GITHUB_APP_ID=0
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=unset
GITHUB_APP_SLUG=hbe-dev
GITHUB_WEBHOOK_SECRET=local-webhook-secret
GRADER_REPO=hbe-dev-org/hbe-grader

ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_BUCKET=
ARCHIVE_OBJECT_LOCK=none

EMAIL_PROVIDER=log
EMAIL_FROM=HBE Dev <dev@localhost>

TOKEN_ENCRYPTION_KEY=local-dev-only
