# ─── Demo: Render FREE (singapore) + Supabase FREE (Singapore) ─────────────────
# Set these in the Render dashboard (or in render.yaml with sync:false). Never commit real values.
HBE_ENV=demo
HBE_PLAN_PROFILE=free
ROLES=web,api,worker
TZ=Asia/Singapore
LOG_LEVEL=info

# Your own hostnames only, never *.onrender.com (see DEPLOYMENT.md §3)
APP_URL=https://app.example.com
API_URL=https://api.example.com

# Supabase project (region: Southeast Asia (Singapore))
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
SUPABASE_SECRET_KEY=<sb_secret_...>
# Transaction pooler (port 6543) for app queries; session pooler (port 5432) for pg-boss.
# Both go through Supavisor over IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
QUEUE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

GITHUB_APP_ID=<id>
GITHUB_APP_CLIENT_ID=<client id>
GITHUB_APP_CLIENT_SECRET=<client secret>
GITHUB_APP_PRIVATE_KEY_BASE64=<base64 .pem>
GITHUB_WEBHOOK_SECRET=<secret>
GRADER_REPO=hbe-demo-org/hbe-grader

# Archive replica: Cloudflare R2 (S3-compatible)
ARCHIVE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_BUCKET=hbe-archive
ARCHIVE_S3_ACCESS_KEY_ID=<r2 key>
ARCHIVE_S3_SECRET_ACCESS_KEY=<r2 secret>
ARCHIVE_OBJECT_LOCK=none

EMAIL_PROVIDER=resend
RESEND_API_KEY=<re_...>
EMAIL_FROM=HBE Platform <no-reply@example.com>

LTI_PRIVATE_KEY_BASE64=<base64 RSA private key>
LTI_KEY_ID=lti-2026-01
GOOGLE_OAUTH_CLIENT_ID=<id>
GOOGLE_OAUTH_CLIENT_SECRET=<secret>
TOKEN_ENCRYPTION_KEY=<32-byte base64>

SENTRY_DSN=
